rules_version = '2';
// กฎของ Firebase Storage — วางใน Firebase Console → Storage → Rules (หรือ deploy ด้วย firebase deploy --only storage)
// ไฟล์ต้นฉบับของแท็บ "อบรม/เกียรติบัตร/รางวัล": users/{uid}/records/{recordId}/{ไฟล์}
// เจ้าของเท่านั้นที่อ่าน/เขียน/ลบได้ (ต้องยืนยันอีเมลเหมือน firestore.rules) · เขียนได้เฉพาะรูปภาพหรือ PDF ไม่เกิน 10 MB
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.uid == uid;
    }
    match /users/{uid}/records/{allPaths=**} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}

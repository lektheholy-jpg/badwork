{
  "name": "badwork",
  "private": true,
  "version": "1.0.0",
  "description": "เครื่องมือ build/ตรวจ CSS+JS ของโปรเจกต์ — ล็อกเวอร์ชันแบบเป๊ะ (ไม่ใช้ ^ หรือ ~) เพื่อให้ผลลัพธ์เหมือนเดิมทุกเครื่อง",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:version": "node tools/version.js",
    "check:version": "node tools/version.js --check",
    "build:css": "sh build-css.sh",
    "check:css": "sh build-css.sh --check",
    "build:js": "node tools/build-js.js",
    "check:js": "node tools/build-js.js --check",
    "build": "npm run build:version && npm run build:css && npm run build:js",
    "test": "node tools/run-tests.js",
    "test:score": "node tests/score-logic.test.js .",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:sw": "node tests/sw.test.js",
    "test:tt": "node tests/timetable-term.test.js",
    "test:rec": "node tests/records.test.js",
    "test:pa": "node tests/pa-config.test.js",
    "test:worker": "node tests/worker.test.js",
    "test:priv": "node tests/privacy.test.js",
    "test:nav": "node tests/nav-history.test.js",
    "test:cache": "node tests/course-cache.test.js",
    "test:tpl": "node tests/course-templates.test.js",
    "test:att": "node tests/attachments.test.js",
    "check:sw": "node tools/check-sw.js",
    "test:ttscope": "node tests/timetable-scope.test.js",
    "test:idp": "node tests/idp-list.test.js",
    "test:idpai": "node tests/idp-ai.test.js",
    "test:docprint": "node tests/doc-print.test.js",
    "test:docprev": "node tests/doc-preview.test.js",
    "test:tra": "node tests/tra.test.js",
    "test:sar": "node tests/sar-merge.test.js",
    "test:sarai": "node tests/sar-ai.test.js",
    "test:sarorder": "node tests/sar-order.test.js",
    "test:car": "node tests/car.test.js",
    "test:docprofile": "node tests/doc-profile.test.js",
    "ci": "npm test && npm run check:css && npm run check:js && npm run check:version",
    "test:cssb": "node tests/css-bundles.test.js",
    "test:rules": "node tests/rules-profile.test.js",
    "test:appearance": "node tests/appearance.test.js",
    "test:island": "node tests/island-ambient.test.js",
    "test:islandclass": "node tests/island-class.test.js",
    "test:settings": "node tests/settings-tabs.test.js",
    "test:push": "node tests/push.test.js",
    "test:cdesc": "node tests/course-desc.test.js",
    "test:cdescai": "node tests/course-desc-ai.test.js",
    "test:syll": "node tests/syllabus.test.js"
  },
  "devDependencies": {
    "csso-cli": "4.0.2",
    "esbuild": "0.28.2",
    "jsdom": "24.1.3",
    "postcss": "8.4.47"
  }
}

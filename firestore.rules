rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ครูแต่ละคนอ่าน/เขียนได้เฉพาะข้อมูลของตัวเอง (uid ต้องตรงกับผู้ใช้ที่ login)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /courses/{courseId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // ครอบคลุมทุก subcollection ใต้รายวิชา แบบ "recursive" จริง ๆ (ลึกกี่ชั้นก็ได้)
        // เช่น courses/{id}/sections/{id}/students/{id}, courses/{id}/sections/{id}/scores/{id}
        // เดิมใช้ match /{subcollection}/{docId} ซึ่งลึกได้แค่ 1 ชั้น ทำให้ sections/{id}/students/{id}
        // (ลึก 2 ชั้นจาก courses) ไม่เข้าเงื่อนไข เกิด "Missing or insufficient permissions"
        match /{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ครูแต่ละคนอ่าน/เขียนได้เฉพาะข้อมูลของตัวเอง (uid ต้องตรงกับผู้ใช้ที่ login)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /courses/{courseId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // ครอบคลุมทุก subcollection ใต้รายวิชา (students, assessments, scores, settings, ...)
        // ใช้ wildcard แบบ recursive กันลืมเพิ่ม match ทุกครั้งที่มี collection ใหม่
        match /{subcollection}/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}

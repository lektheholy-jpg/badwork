rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ต้องล็อกอินด้วยบัญชีที่ยืนยันอีเมลแล้ว
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // จำกัดเฉพาะบัญชีโรงเรียน: ถ้าต้องการ ให้เปลี่ยน return true เป็นโดเมนจริง เช่น
    //   return request.auth.token.email.matches('.*@school\\.ac\\.th$');
    function schoolUser() {
      return true;
    }

    function isOwner(uid) {
      return signedIn() && schoolUser() && request.auth.uid == uid;
    }

    // ข้อความ/ค่าว่างที่ยอมรับได้ (กันเอกสารใหญ่ผิดปกติ)
    function okStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // ข้อมูลส่วนตัวของครู (หน้า "ข้อมูลส่วนตัว" → users/{uid}.profile) · รายชื่อฟิลด์ต้องตรงกับ PROFILE_FIELDS ใน js/profile.js
    // ข้อความยาวไม่เกิน 200 ตัวอักษร · salary เป็นตัวเลขหรือ null · birthDate/startDate = YYYY-MM-DD · education = list ไม่เกิน 10 วุฒิ ([{level, major, institution, year}])
    function validTeacherProfile(p) {
      return p == null || (p is map
        && p.keys().hasOnly(['prefix', 'firstName', 'lastName', 'phone',
                             'position', 'academicStanding', 'ksLevel', 'salary', 'positionNo', 'subjectGroup',
                             'school', 'affiliation',
                             'director', 'deputyAcademic', 'subjectHead', 'assessmentHead',
                             'birthDate', 'startDate', 'licenseNo', 'education'])
        && okStr(p.get('prefix', null), 200) && okStr(p.get('firstName', null), 200) && okStr(p.get('lastName', null), 200)
        && okStr(p.get('phone', null), 200) && okStr(p.get('position', null), 200) && okStr(p.get('academicStanding', null), 200)
        && okStr(p.get('ksLevel', null), 200) && okStr(p.get('positionNo', null), 200) && okStr(p.get('subjectGroup', null), 200)
        && okStr(p.get('school', null), 200) && okStr(p.get('affiliation', null), 200)
        && okStr(p.get('director', null), 200) && okStr(p.get('deputyAcademic', null), 200)
        && okStr(p.get('subjectHead', null), 200) && okStr(p.get('assessmentHead', null), 200)
        && okStr(p.get('birthDate', null), 10) && okStr(p.get('startDate', null), 10) && okStr(p.get('licenseNo', null), 200)
        && (p.get('education', null) == null || (p.get('education', null) is list && p.get('education', null).size() <= 10))
        && (p.get('salary', null) == null || p.get('salary', null) is number));
    }

    // โปรไฟล์ครู: มีเฉพาะฟิลด์ที่แอปเขียนจริง
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'email', 'photoURL', 'lastLogin', 'profile'])
        && okStr(d.get('displayName', null), 200)
        && okStr(d.get('email', null), 320)
        && okStr(d.get('photoURL', null), 2048)
        && validTeacherProfile(d.get('profile', null));
    }

    // ตารางสอน (แท็บ "ตารางสอน" ในหน้าข้อมูลส่วนตัว → users/{uid}/timetable/{ปี}-{ภาค} เช่น 2569-1 · main = แบบเดิมก่อนแยกภาคเรียน) · ฟิลด์ต้องตรงกับ js/timetable.js
    // periods = เวลาคาบ (สูงสุด 14) · entries = คาบที่ลงในตาราง (5 วัน x 14 คาบ ไม่เกิน 70 รายการ เผื่อไว้ 100)
    function validTimetable() {
      let d = request.resource.data;
      return d.keys().hasOnly(['periods', 'entries', 'updatedAt'])
        && d.get('periods', []) is list && d.get('periods', []).size() <= 14
        && d.get('entries', []) is list && d.get('entries', []).size() <= 100;
    }

    // การอบรม/เกียรติบัตร/รางวัล (แท็บ "อบรม/เกียรติบัตร/รางวัล" → users/{uid}/records/{id}) · ฟิลด์ต้องตรงกับ js/records.js
    // thumb = รูปย่อ data URL (ไม่เกิน ~90,000 ตัวอักษร) · file = ข้อมูลไฟล์ต้นฉบับใน Storage หรือ null
    function validRecord() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'title', 'org', 'date', 'year', 'hours', 'note', 'thumb', 'file', 'createdAt', 'updatedAt'])
        && d.get('type', '') in ['training', 'certificate', 'award']
        && d.get('title', '') is string && d.get('title', '').size() > 0 && d.get('title', '').size() <= 200
        && okStr(d.get('org', null), 200) && okStr(d.get('note', null), 500) && okStr(d.get('date', null), 10)
        && d.get('year', 0) is number && d.get('hours', 0) is number
        && okStr(d.get('thumb', null), 90000)
        && (d.get('file', null) == null || (d.file is map && d.file.keys().hasOnly(['path', 'name', 'size', 'type'])));
    }

    // เอกสารใต้รายวิชา: จำกัดจำนวนฟิลด์ (เอกสาร scores เก็บคะแนนต่อชิ้นงานจึงเผื่อไว้มากกว่า)
    function validDoc(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();

      match /timetable/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTimetable();
      }

      match /records/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRecord();
      }

      // ข้อตกลง PA (หน้า "ข้อตกลง PA" → users/{uid}/pa_agreements/{docId}) · ฟิลด์ดูที่ js/pa.js
      match /pa_agreements/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDoc(30);
      }

      // แบบรายงานผล Personal Agreement (แท็บ "แบบฟอร์มรายงานผล" → users/{uid}/pa_reports/{docId}) · ฟิลด์ดูที่ js/pa-rpt.js
      match /pa_reports/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDoc(30);
      }

      // แผนพัฒนาตนเอง ID-Plan → users/{uid}/idp_plans/{docId} · ฟิลด์ดูที่ js/idp.js
      match /idp_plans/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDoc(30);
      }

      // รายงานผลการปฏิบัติงานและการประเมินตนเอง SAR (แท็บ SAR ในหน้า ID-Plan) → users/{uid}/idp_sar/{docId} · ฟิลด์ดูที่ js/sar.js
      match /idp_sar/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDoc(30);
      }

      // แผนการอบรม → users/{uid}/tra_docs/{docId} · ฟิลด์ดูที่ js/tra.js (สร้างโดย tools/new-doc-system.js)
      match /tra_docs/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDoc(30);
      }

      match /courses/{courseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDoc(40);

        match /sections/{sectionId}/scores/{studentId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validDoc(500);
        }

        // ที่เหลือใต้รายวิชา (assessments, settings, sections, students ฯลฯ)
        match /{document=**} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validDoc(100);
        }
      }
    }
  }
}

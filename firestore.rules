rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ต้องล็อกอินด้วยบัญชีที่ยืนยันอีเมลแล้ว
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // จำกัดเฉพาะบัญชีโรงเรียน: ถ้าต้องการ ให้เปลี่ยน return true เป็นโดเมนจริง เช่น
    //   return request.auth.token.email.matches('.*@school\\.ac\\.th$');
    function schoolUser() {
      return true;
    }

    function isOwner(uid) {
      return signedIn() && schoolUser() && request.auth.uid == uid;
    }

    // ข้อความ/ค่าว่างที่ยอมรับได้ (กันเอกสารใหญ่ผิดปกติ)
    function okStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // โปรไฟล์ครู: มีเฉพาะฟิลด์ที่แอปเขียนจริง
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'email', 'photoURL', 'lastLogin'])
        && okStr(d.get('displayName', null), 200)
        && okStr(d.get('email', null), 320)
        && okStr(d.get('photoURL', null), 2048);
    }

    // เอกสารใต้รายวิชา: จำกัดจำนวนฟิลด์ (เอกสาร scores เก็บคะแนนต่อชิ้นงานจึงเผื่อไว้มากกว่า)
    function validDoc(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();

      match /courses/{courseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDoc(40);

        match /sections/{sectionId}/scores/{studentId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validDoc(500);
        }

        // ที่เหลือใต้รายวิชา (assessments, settings, sections, students ฯลฯ)
        match /{document=**} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validDoc(100);
        }
      }
    }
  }
}
